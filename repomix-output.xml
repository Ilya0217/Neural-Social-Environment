        .container { max-width:1400px; margin:0 auto; padding:24px; }
        h1 { margin:0 0 8px; font-weight:600; }
        h2 { margin-top:32px; border-bottom:1px solid #2a2f3a; padding-bottom:8px; }
        h3 { color:#a5b4fc; margin-top:24px; }
        .card { background:#1a1d24; border:1px solid #2a2f3a; border-radius:10px; padding:20px; margin-bottom:16px; }
        .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
        .grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
        table { width:100%; border-collapse:collapse; margin:12px 0; font-size:14px; }
        th, td { padding:8px 10px; text-align:left; border-bottom:1px solid #2a2f3a; }
        th { background:#22262f; font-weight:600; color:#a5b4fc; }
