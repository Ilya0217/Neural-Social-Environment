<file path="webapp/static/style.css">
:root {
  --bg: #f5f7fb;
  --bg-secondary: #eef3fb;
  --panel: rgba(255,255,255,.88);
  --panel-hover: rgba(255,255,255,.96);
  --muted: #6b7280;
  --text: #0f172a;
  --text-dim: #475569;
  --text-secondary: #64748b;
  --accent: #2563eb;
  --accent-glow: rgba(37,99,235,.12);
  --primary: #16a34a;
  --primary-glow: rgba(22,163,74,.1);
  --danger: #dc2626;
  --warning: #d97706;
  --border: rgba(15,23,42,.09);
  --border-light: rgba(15,23,42,.16);
  --gradient-start: #2563eb;
  --gradient-end: #0ea5e9;
  --glass: rgba(255,255,255,.82);
  --glass-border: rgba(15,23,42,.08);
  --glass-blur: 40px;
  --tone-positive: #16a34a;
  --tone-neutral: rgba(100,116,139,.55);
  --tone-negative: #dc2626;
  --radius: 16px;
  --radius-sm: 10px;
  --radius-xs: 8px;
  --shadow: 0 14px 40px rgba(15,23,42,.10);
  --shadow-sm: 0 4px 16px rgba(15,23,42,.08);
}

*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  background:linear-gradient(180deg,#f8fbff 0%, var(--bg) 42%, #eef4fb 100%);
  font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Outfit',system-ui,sans-serif;
  color:var(--text);line-height:1.5;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

/* ==================== GLASS UTILITY ==================== */
.glass{
  background:var(--glass);
  backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  border:1px solid var(--glass-border);
}

/* Scrollbar */
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(15,23,42,.14);border-radius:10px}
::-webkit-scrollbar-thumb:hover{background:rgba(15,23,42,.24)}

/* Selection */
::selection{background:rgba(37,99,235,.18);color:var(--text)}

/* ==================== WIZARD ==================== */
.wizard-overlay{
  position:fixed;inset:0;background:linear-gradient(180deg,#f8fbff 0%, #f2f6fd 100%);
  display:flex;align-items:flex-start;justify-content:center;
  padding:24px;overflow-y:auto;z-index:1000;
}
.wizard-container{width:100%;max-width:680px;margin:auto;animation:fadeUp .5s cubic-bezier(.16,1,.3,1)}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

.wizard-step{
  display:none;background:var(--glass);
  backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  border:1px solid var(--glass-border);
  border-radius:24px;padding:32px;
  box-shadow:var(--shadow),inset 0 1px 0 rgba(255,255,255,.7);
  max-height:none;min-height:calc(100vh - 48px);overflow-y:auto;flex-direction:column;
}
.wizard-step.active{display:flex;animation:slideIn .4s cubic-bezier(.16,1,.3,1)}
@keyframes slideIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:translateX(0)}}

.wizard-header{text-align:center;margin-bottom:28px;flex-shrink:0}
.wizard-header.compact{margin-bottom:20px}
.wizard-icon{
  display:inline-flex;align-items:center;justify-content:center;
  width:64px;height:64px;
  background:linear-gradient(135deg,rgba(10,132,255,.15),rgba(191,90,242,.15));
  border-radius:20px;margin-bottom:16px;color:var(--accent);
  border:1px solid rgba(10,132,255,.2);
}
.wizard-header h1{
  margin:0;font-size:28px;font-weight:700;letter-spacing:-.02em;
  background:linear-gradient(135deg,#0f172a,#2563eb);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.wizard-header h2{margin:0;font-size:20px;font-weight:600;letter-spacing:-.01em}
.wizard-subtitle{margin:8px 0 0;color:var(--muted);font-size:14px;font-weight:400}
.step-indicator{margin-bottom:10px}
.step-badge{
  display:inline-block;padding:5px 14px;
  background:rgba(10,132,255,.1);border:1px solid rgba(10,132,255,.2);
  border-radius:20px;font-size:12px;font-weight:500;color:var(--accent);
}

.wizard-content{margin-bottom:24px;flex-shrink:0}
.wizard-content-scroll{flex:1;overflow-y:auto;margin-bottom:20px;padding-right:8px;min-height:0}
.wizard-content-scroll .wizard-content{margin-bottom:0}
.wizard-label{display:block;font-size:13px;font-weight:500;color:var(--text-dim);margin-bottom:10px}

/* Slider */
.slider-container{
  display:flex;flex-direction:column;align-items:center;gap:16px;
  padding:24px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:20px;
}
.agent-slider{
  -webkit-appearance:none;width:100%;height:4px;
  background:rgba(255,255,255,.1);border-radius:2px;outline:none;cursor:pointer;
}
.agent-slider::-webkit-slider-thumb{
  -webkit-appearance:none;width:24px;height:24px;
  background:#fff;border-radius:50%;cursor:pointer;
  box-shadow:0 2px 8px rgba(0,0,0,.3),0 0 0 1px rgba(0,0,0,.1);
  transition:transform .2s cubic-bezier(.16,1,.3,1);
}
.agent-slider::-webkit-slider-thumb:hover{transform:scale(1.15)}
.agent-slider::-moz-range-thumb{
  width:24px;height:24px;background:#fff;border:none;border-radius:50%;cursor:pointer;
  box-shadow:0 2px 8px rgba(0,0,0,.3);
}
.slider-value{font-size:28px;font-weight:700;font-family:-apple-system,monospace;color:var(--text);text-align:center}
.slider-value span{
  font-size:48px;font-weight:800;letter-spacing:-.04em;
  background:linear-gradient(135deg,#0f172a,#2563eb);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}

/* Inputs */
.wizard-select,.wizard-input{
  width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:var(--radius-sm);
  background:rgba(255,255,255,.92);color:var(--text);font-size:14px;font-family:inherit;
  transition:all .2s cubic-bezier(.16,1,.3,1);
}
.wizard-select:hover,.wizard-input:hover{border-color:var(--border-light);background:#fff}
.wizard-select:focus,.wizard-input:focus{
  outline:none;border-color:var(--accent);
  box-shadow:0 0 0 4px rgba(37,99,235,.12);background:#fff;
}
.wizard-input::placeholder{color:#94a3b8}
.wizard-color{
  width:100%;height:44px;border:1px solid var(--border);border-radius:var(--radius-sm);
  background:rgba(255,255,255,.92);cursor:pointer;padding:4px;
}
.wizard-color::-webkit-color-swatch-wrapper{padding:0}
.wizard-color::-webkit-color-swatch{border:none;border-radius:6px}

/* Agent form */
.agent-form .form-row{display:grid;grid-template-columns:1fr 1.5fr 80px;gap:12px;margin-bottom:16px}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-group label{font-size:12px;font-weight:500;color:var(--text-dim)}
.color-group{width:80px}

/* Questionnaire */
.questionnaire{background:rgba(248,250,252,.95);border:1px solid var(--border);border-radius:var(--radius);padding:20px}
.questionnaire-title{margin:0 0 4px;font-size:15px;font-weight:600}
.questionnaire-hint{margin:0 0 16px;font-size:12px;color:var(--muted)}
.questionnaire-section{margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border)}
.questionnaire-section:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}
.section-title{
  font-size:12px;font-weight:600;color:var(--primary);margin-bottom:14px;
  text-transform:uppercase;letter-spacing:.06em;
}
.questionnaire .form-group{margin-bottom:12px}
.questionnaire .form-group:last-child{margin-bottom:0}

/* Wizard buttons */
.wizard-actions{display:flex;gap:10px;justify-content:flex-end;flex-shrink:0;flex-wrap:wrap}
.wizard-btn{
  display:inline-flex;align-items:center;gap:6px;padding:12px 22px;border:none;
  border-radius:var(--radius-sm);font-size:14px;font-weight:500;font-family:inherit;
  cursor:pointer;transition:all .25s cubic-bezier(.16,1,.3,1);
}
.wizard-btn-secondary{background:#fff;border:1px solid var(--border);color:var(--text-dim)}
.wizard-btn-secondary:hover{background:#f8fafc;color:var(--text);border-color:var(--border-light)}
.wizard-btn-primary{background:var(--accent);color:white;box-shadow:0 4px 16px rgba(10,132,255,.3)}
.wizard-btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(10,132,255,.35);filter:brightness(1.1)}
.wizard-btn-success{background:var(--primary);color:white;box-shadow:0 4px 16px rgba(48,209,88,.25)}
.wizard-btn-success:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(48,209,88,.3);filter:brightness(1.1)}

/* Agent preview */
.agent-preview{margin-top:20px;padding-top:16px;border-top:1px solid var(--border);flex-shrink:0}
.agent-preview h4{margin:0 0 12px;font-size:12px;font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.agent-cards{display:flex;flex-wrap:wrap;gap:8px;max-height:120px;overflow-y:auto}
.agent-card{
  display:flex;align-items:center;gap:8px;padding:8px 14px;
  background:rgba(255,255,255,.92);border:1px solid var(--border);border-radius:var(--radius-xs);
  cursor:pointer;transition:all .2s;flex-shrink:0;
}
.agent-card:hover{border-color:var(--border-light);background:#fff}
.agent-card.active{border-color:var(--accent);background:var(--accent-glow)}
.agent-card-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.agent-card-name{font-size:13px;font-weight:500}
.agent-card-nature{font-size:11px;color:var(--muted)}

/* ==================== MAIN APP ==================== */
.container{max-width:1400px;margin:0 auto;padding:16px 20px}

/* Header */
.header{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  margin-bottom:16px;padding:14px 20px;
  background:var(--glass);
  backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  border:1px solid var(--glass-border);border-radius:var(--radius);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04);
}
.header h1{
  margin:0;font-size:20px;font-weight:700;letter-spacing:-.02em;
  background:linear-gradient(135deg,#0f172a,#2563eb);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.subtitle{color:var(--muted);margin-top:2px;font-size:12px}
.controls{display:flex;gap:6px;align-items:center;flex-wrap:wrap}

/* Buttons */
.btn{
  padding:8px 16px;border-radius:var(--radius-xs);border:1px solid var(--border);
  background:#fff;color:var(--text-dim);cursor:pointer;
  transition:all .2s cubic-bezier(.16,1,.3,1);
  font-family:inherit;font-size:12px;font-weight:500;white-space:nowrap;
}
.btn:hover{border-color:var(--border-light);background:#f8fafc;color:var(--text)}
.btn-primary{background:var(--accent);border:none;color:white}
.btn-primary:hover{box-shadow:0 4px 16px rgba(10,132,255,.3);transform:translateY(-1px);filter:brightness(1.1)}
.btn:disabled{opacity:.3;cursor:not-allowed;transform:none!important;filter:none!important}
.btn-download{color:var(--muted)}

/* Agent Badges */
.agent-badges{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.agent-badge{
  display:flex;align-items:center;gap:8px;padding:7px 14px;
  background:var(--glass);
  backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);
  border:1px solid var(--glass-border);border-radius:var(--radius-sm);
  transition:all .2s;
}
.agent-badge:hover{border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.08)}
.agent-badge-observer{border-style:dashed;opacity:.7}
.agent-badge-observer:hover{opacity:1}
.agent-badge-dot{width:8px;height:8px;border-radius:50%;box-shadow:0 0 8px currentColor}
.agent-badge-name{font-size:12px;font-weight:600;letter-spacing:-.01em}
.agent-badge-nature{font-size:10px;color:var(--muted)}

/* Tabs */
.tab-nav{
  display:flex;gap:2px;margin-bottom:14px;padding:3px;
  background:rgba(255,255,255,.75);border:1px solid var(--border);
  border-radius:12px;width:fit-content;
}
.tab-btn{
  padding:8px 18px;border:none;border-radius:var(--radius-xs);background:transparent;
  color:var(--text-dim);font-size:12px;font-weight:500;font-family:inherit;
  cursor:pointer;transition:all .2s;
}
.tab-btn:hover{color:var(--text);background:rgba(15,23,42,.04)}
.tab-btn.active{
  background:#ffffff;color:var(--text);
  box-shadow:0 1px 4px rgba(15,23,42,.08),inset 0 1px 0 rgba(255,255,255,.7);
}

.tab-content{display:none}
.tab-content.active{display:grid}

/* Grid */
.grid{display:grid;grid-template-columns:1.3fr 1fr;grid-template-rows:auto auto;gap:12px}
.panel{
  background:var(--glass);
  backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(180%);
  border:1px solid var(--glass-border);border-radius:var(--radius);padding:16px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04);
}
.panel h2{
  margin:0 0 12px;font-size:11px;font-weight:600;color:var(--muted);
  text-transform:uppercase;letter-spacing:.08em;
}

.transcript{grid-column:1/2;grid-row:1/3}
.graph{grid-column:2/3;grid-row:1/2}
.insights{grid-column:2/3;grid-row:2/3}

.scroll{height:calc(78vh);overflow:auto;padding-right:4px}

/* Typing */
.typing{display:flex;align-items:center;gap:8px;color:var(--muted);padding:8px 0}
.typing .dots i{opacity:.2;animation:blink 1.2s infinite;font-style:normal}
.typing .dots i:nth-child(2){animation-delay:.2s}
.typing .dots i:nth-child(3){animation-delay:.4s}
@keyframes blink{0%{opacity:.2}20%{opacity:1}100%{opacity:.2}}

/* ==================== MESSAGES ==================== */
.msg{
  padding:12px 14px;border-radius:12px;
  background:rgba(255,255,255,.84);
  border:1px solid transparent;
  border-left:2px solid var(--border);
  margin-bottom:8px;
  animation:msgIn .35s cubic-bezier(.16,1,.3,1);
  transition:all .15s;
}
.msg:hover{background:#fff;border-color:var(--border)}
@keyframes msgIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}

.msg .meta{
  color:var(--muted);font-size:10px;margin-bottom:5px;
  font-family:'SF Mono','JetBrains Mono',monospace;
  display:flex;align-items:center;gap:6px;flex-wrap:wrap;
}
.msg .meta .speaker{font-weight:600;font-size:11px}
.msg .meta .arrow{color:rgba(15,23,42,.20);font-size:10px}
.msg .meta .target{font-weight:500;color:var(--text-dim)}
.msg .meta .tone-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.msg .meta .tone-label{font-size:9px;color:var(--muted);font-style:italic}
.msg .text{line-height:1.6;font-size:14px;color:var(--text);font-weight:400}

/* Graph */
.img-wrap{
  display:flex;align-items:center;justify-content:center;height:38vh;
  background:rgba(255,255,255,.7);border-radius:12px;
  border:1px dashed rgba(15,23,42,.10);overflow:hidden;position:relative;
}
.img-wrap img{max-width:100%;max-height:100%;display:block;border-radius:8px}
.graph-placeholder{
  display:flex;flex-direction:column;align-items:center;gap:12px;
  color:rgba(15,23,42,.28);font-size:12px;font-weight:500;
  animation:placeholderPulse 3s ease-in-out infinite;
}
@keyframes placeholderPulse{0%,100%{opacity:.6}50%{opacity:1}}

/* Loading overlay */
.loading-overlay{
  position:fixed;inset:0;z-index:2000;
  background:rgba(245,247,251,.84);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;
}
.loading-spinner{
  width:48px;height:48px;border-radius:50%;
  border:3px solid rgba(15,23,42,.08);
  border-top-color:var(--accent);
  animation:spin .8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{
  color:var(--text-dim);font-size:14px;font-weight:500;
  text-align:center;max-width:300px;line-height:1.6;
}
.loading-agent{
  color:var(--accent);font-size:13px;font-weight:600;
  font-family:'SF Mono','JetBrains Mono',monospace;
  min-height:20px;transition:opacity .2s;
}
.loading-dots{display:inline-flex;gap:4px;margin-left:4px}
.loading-dots span{
  width:4px;height:4px;border-radius:50%;background:var(--accent);
  animation:blink 1.2s infinite;
}
.loading-dots span:nth-child(2){animation-delay:.2s}
.loading-dots span:nth-child(3){animation-delay:.4s}

.list{margin:0;padding-left:18px}
.list li{margin-bottom:8px;line-height:1.5;font-size:13px;color:var(--text-dim)}

.footer{margin-top:12px;color:var(--muted);font-size:11px;padding:6px 0}

/* Metrics */
.tbl-wrap{overflow:auto;border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.88)}
.metrics-table{width:100%;border-collapse:collapse;min-width:520px}
.metrics-table thead th{
  position:sticky;top:0;background:rgba(248,250,252,.96);color:var(--text-dim);
  text-align:left;padding:10px 14px;font-weight:600;font-size:10px;
  border-bottom:1px solid var(--border);text-transform:uppercase;letter-spacing:.06em;
  backdrop-filter:blur(20px);
}
.metrics-table tbody td{padding:9px 14px;border-bottom:1px solid rgba(15,23,42,.05);font-size:12px}
.metrics-table tbody tr:hover{background:rgba(15,23,42,.02)}
.metrics-table td:nth-child(2),.metrics-table td:nth-child(3){
  text-align:right;font-variant-numeric:tabular-nums;font-family:'SF Mono','JetBrains Mono',monospace;
}
.spacer{height:8px}

/* ==================== SCIENTIFIC ==================== */
.scientific-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:12px}
.scientific-report{grid-column:1/2}
.scientific-hypotheses{grid-column:2/3}

.scientific-info{
  background:rgba(255,255,255,.82);border:1px solid var(--border);
  border-radius:12px;padding:14px;margin-bottom:14px;
}
.scientific-info p{margin:0 0 8px;color:var(--text-dim);font-size:12px}
.scientific-info ul{margin:0;padding-left:18px}
.scientific-info li{margin-bottom:4px;font-size:11px;color:var(--muted)}
.scientific-info li strong{color:var(--text-dim)}

.scientific-content{height:calc(65vh)}
.scientific-content h1,.scientific-content h2,.scientific-content h3{margin-top:16px;margin-bottom:8px}
.scientific-content h1{font-size:18px;margin-top:0;font-weight:700;letter-spacing:-.01em}
.scientific-content h2{font-size:15px;color:var(--accent);font-weight:600}
.scientific-content h3{font-size:13px;font-weight:600}
.scientific-content p{margin:5px 0;line-height:1.6;font-size:13px;color:var(--text-dim)}
.scientific-content ul{margin:5px 0;padding-left:18px}
.scientific-content li{margin-bottom:4px;font-size:12px}

/* Hypothesis cards */
.sci-hyp-card{
  background:rgba(255,255,255,.86);border:1px solid var(--border);
  border-radius:12px;padding:14px;margin-bottom:8px;transition:all .2s;
}
.sci-hyp-card:hover{border-color:var(--border-light);background:#fff}
.sci-hyp-header{display:flex;align-items:center;gap:6px;margin-bottom:8px;flex-wrap:wrap}
.sci-hyp-category{
  font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
  color:var(--accent);background:var(--accent-glow);padding:3px 8px;border-radius:6px;
}
.sci-hyp-framework{font-size:10px;color:var(--muted)}
.sci-hyp-finding{font-size:12px;line-height:1.5;margin-bottom:8px;color:var(--text-dim)}
.sci-hyp-recommendation{
  font-size:11px;line-height:1.5;color:var(--text-dim);padding:10px 12px;
  background:rgba(248,250,252,.95);border-radius:var(--radius-xs);margin-bottom:8px;
  border-left:2px solid rgba(10,132,255,.4);
}
.sci-hyp-reference{font-size:9px;color:var(--muted);font-style:italic}

/* ==================== OBSERVER ==================== */
.stat-card{
  background:rgba(255,255,255,.88);border-radius:14px;padding:1.2rem;
  text-align:center;border:1px solid var(--border);transition:all .2s;
}
.stat-card:hover{border-color:rgba(10,132,255,.3);background:rgba(10,132,255,.05)}
.stat-card .stat-value{
  font-size:2rem;font-weight:700;color:var(--text);line-height:1.2;
  font-family:'SF Mono',-apple-system,monospace;letter-spacing:-.03em;
}
.stat-card .stat-label{
  font-size:.65rem;color:var(--muted);margin-top:.4rem;
  text-transform:uppercase;letter-spacing:.08em;font-weight:500;
}

#observerReport h1,#observerReport h2,#observerReport h3{margin-top:1rem;margin-bottom:.4rem}
#observerReport h2{color:var(--accent)}
#observerReport hr{border:none;border-top:1px solid var(--border);margin:1.2rem 0}
#observerReport ul{padding-left:1.5rem;margin:.4rem 0}
#observerReport li{margin-bottom:.3rem;line-height:1.5;font-size:13px}

/* Big Five */
.agent-badge[title]{cursor:help}
.agent-badge-b5{display:inline-flex;gap:1px;margin-left:8px;vertical-align:middle}
.b5-bar{
  display:inline-block;width:12px;height:16px;font-size:7px;font-weight:700;
  line-height:16px;text-align:center;color:rgba(255,255,255,.7);border-radius:3px;
  background:linear-gradient(to top,var(--accent) calc(var(--val)*100%),rgba(255,255,255,.06) calc(var(--val)*100%));
  cursor:help;transition:all .2s cubic-bezier(.16,1,.3,1);
}
.b5-bar:hover{transform:scaleY(1.4) translateY(-1px);filter:brightness(1.2)}

/* ==================== RESPONSIVE ==================== */
@media(max-width:900px){
  .grid{grid-template-columns:1fr}
  .transcript,.graph,.insights,.metrics{grid-column:1;grid-row:auto}
  .scroll{height:50vh}
  .img-wrap{height:28vh}
  .wizard-container{max-width:100%}
  .agent-form .form-row{grid-template-columns:1fr 1fr}
  .color-group{width:100%;grid-column:1/-1}
  .header{flex-direction:column;align-items:flex-start}
  .scientific-grid{grid-template-columns:1fr}
  .scientific-report,.scientific-hypotheses{grid-column:1}
  .scientific-content{height:40vh}
  .tab-nav{width:100%}
  .tab-btn{flex:1;text-align:center;font-size:11px;padding:8px 10px}
  .container{padding:12px}
}

/* ==================== USER PARTICIPATION ==================== */
.msg-user {
  border-left-color: #405686 !important;
  background: rgba(64, 86, 134, 0.08);
}
.you-tag {
  font-size: 0.75em;
  opacity: 0.6;
  margin-left: 4px;
}
.btn-participate {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  border: none;
  font-weight: 500;
}
.btn-participate:hover {
  filter: brightness(1.15);
}
.btn-participate-pulse {
  animation: participate-pulse 1.5s ease-in-out infinite;
}
@keyframes participate-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.5); }
  50% { box-shadow: 0 0 0 8px rgba(99, 102, 241, 0); }
}

/* Modal */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.18);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-card {
  background: var(--glass);
  backdrop-filter: blur(var(--glass-blur)) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 2rem;
  width: 480px;
  max-width: 90vw;
  box-shadow: var(--shadow);
}
.modal-card h3 {
  margin: 0 0 1.5rem;
  color: var(--text);
  font-size: 1.2rem;
}
.modal-card .form-group {
  margin-bottom: 1rem;
}
.modal-card label {
  display: block;
  margin-bottom: 0.4rem;
  font-size: 0.85rem;
  color: var(--text-dim);
}
.modal-card textarea {
  width: 100%;
  resize: vertical;
  min-height: 60px;
}
.modal-actions {
  display: flex;
  gap: 0.75rem;
  justify-content: flex-end;
  margin-top: 1.5rem;
}
</file>

<file path="webapp/templates/experiment_links.html">
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Experiment — Join Links</title>
    <link rel="stylesheet" href="/static/style.css">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { padding: 32px; max-width: 900px; margin: 0 auto; }
        h1 { text-align: center; margin-bottom: 8px; }
        .subtitle { text-align: center; color: var(--text-dim); margin-bottom: 32px; }
        .link-card {
            display: flex; align-items: center; gap: 16px;
            padding: 16px 20px; margin: 8px 0;
            background: var(--surface); border-radius: 12px;
            border: 1px solid var(--border);
            transition: border-color 0.2s;
        }
        .link-card:hover { border-color: var(--accent); }
        .link-name {
            font-size: 20px; font-weight: 600;
            min-width: 160px; color: var(--text);
        }
        .link-url {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px; color: var(--accent);
            word-break: break-all; flex: 1;
        }
        .link-url a { color: var(--accent); text-decoration: none; }
        .link-url a:hover { text-decoration: underline; }
        .copy-btn {
            padding: 8px 16px; border-radius: 8px;
            background: var(--accent); color: white;
            border: none; cursor: pointer; font-size: 13px;
            white-space: nowrap;
        }
        .copy-btn:hover { opacity: 0.85; }
        .copy-btn.copied { background: var(--tone-positive); }
        .instructions {
            margin-top: 32px; padding: 20px;
            background: var(--surface); border-radius: 12px;
            border: 1px solid var(--border);
        }
        .instructions h2 { margin-top: 0; font-size: 16px; }
        .instructions ol { padding-left: 20px; }
        .instructions li { margin: 8px 0; color: var(--text-dim); }
        .copy-all-btn {
            display: block; margin: 24px auto;
            padding: 12px 32px; border-radius: 12px;
            background: var(--accent); color: white;
            border: none; cursor: pointer; font-size: 16px;
            font-weight: 600;
        }
        .copy-all-btn:hover { opacity: 0.85; }
    </style>
</head>
<body>
    <h1>Dialogue Experiment</h1>
    <p class="subtitle">{{ env }}</p>

    <button class="copy-all-btn" onclick="copyAll()">Copy All Links</button>

    {% for name, url in links.items() %}
    <div class="link-card">
        <span class="link-name">{{ name }}</span>
        <span class="link-url"><a href="{{ url }}" target="_blank">{{ url }}</a></span>
        <button class="copy-btn" onclick="copyLink(this, '{{ url }}')">Copy</button>
    </div>
    {% endfor %}

    <div class="instructions">
        <h2>Instructions for participants:</h2>
        <ol>
            <li>Open your personal link on your phone or laptop</li>
            <li>Click <strong>"Join Experiment"</strong></li>
            <li>When you see <strong>"YOUR TURN"</strong> (green banner) — write your message</li>
            <li>Select who you're addressing, type your message, click <strong>Send</strong></li>
            <li>Wait for others — the grey banner shows whose turn it is</li>
        </ol>
    </div>

    <script>
    function copyLink(btn, url) {
        navigator.clipboard.writeText(url).then(() => {
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
        });
    }
    function copyAll() {
        const links = [];
        {% for name, url in links.items() %}
        links.push('{{ name }}: {{ url }}');
        {% endfor %}
        navigator.clipboard.writeText(links.join('\n')).then(() => {
            const btn = document.querySelector('.copy-all-btn');
            btn.textContent = 'Copied all!';
            setTimeout(() => { btn.textContent = 'Copy All Links'; }, 2000);
        });
    }
    </script>
</body>
</html>
</file>

<file path="webapp/templates/experiment.html">
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Experiment — Participant View</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .exp-turn-banner {
            padding: 16px 24px;
            border-radius: 12px;
            text-align: center;
            font-size: 18px;
            font-weight: 600;
            margin: 12px 24px;
            transition: all 0.3s ease;
        }
        .exp-turn-banner.my-turn {
            background: rgba(16, 185, 129, 0.15);
            border: 2px solid var(--tone-positive);
            color: var(--tone-positive);
            animation: pulse-border 1.5s ease-in-out infinite;
        }
        @keyframes pulse-border {
            0%, 100% { border-color: var(--tone-positive); }
            50% { border-color: rgba(16, 185, 129, 0.4); }
        }
        .exp-turn-banner.waiting {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-dim);
        }
        .exp-turn-banner.processing {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid var(--accent);
            color: var(--accent);
        }
        .exp-input-area {
            transition: opacity 0.3s ease;
        }
        .exp-input-area.disabled {
            opacity: 0.35;
            pointer-events: none;
        }
        .exp-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            padding: 0 24px 24px;
        }
        .exp-left {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .exp-participant-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 4px;
        }
        .you-highlight {
            border: 2px solid var(--accent) !important;
        }
    </style>
</head>
<body>
    <!-- JOIN SCREEN -->
    <div id="joinScreen" class="wizard-overlay">
        <div class="wizard-container" style="max-width: 480px;">
            <div class="wizard-header">
                <div class="wizard-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="9" cy="7" r="3"/><circle cx="17" cy="11" r="3"/>
                        <path d="M3 21v-2a4 4 0 014-4h4"/><path d="M21 21v-2a4 4 0 00-3-3.87"/>
                    </svg>
                </div>
                <h1>Dialogue Experiment</h1>
                <p class="wizard-subtitle">Enter your participant name to join</p>
            </div>
            <div class="wizard-content">
                <div class="form-group">
                    <label>Your name:</label>
                    <input type="text" id="nameInput" class="wizard-input" placeholder="Enter your name...">
                </div>
                <p id="joinError" style="color: var(--tone-negative); display: none; margin-top: 8px;"></p>
            </div>
            <div class="wizard-actions">
                <button id="joinBtn" class="wizard-btn wizard-btn-primary">Join Experiment</button>
            </div>
        </div>
    </div>

    <!-- MAIN EXPERIMENT VIEW -->
    <div id="expMain" style="display: none;">
        <header class="header">
            <div>
                <h1>Dialogue Experiment</h1>
                <p class="subtitle" id="expEnv"></p>
            </div>
            <div class="controls">
                <span id="myNameBadge" class="agent-badge" style="font-weight: 600; border: 1px solid var(--accent);"></span>
                <span id="expTurn" style="color: var(--text-dim); font-size: 13px;">Turn: 0</span>
            </div>
        </header>

        <!-- Turn indicator banner -->
        <div id="turnBanner" class="exp-turn-banner waiting">
            <span id="turnText">Connecting...</span>
        </div>

        <!-- Participants bar -->
        <div id="participantsBar" class="agent-badges"></div>

        <!-- Main grid -->
        <div class="exp-grid">
            <div class="exp-left">
                <!-- Input area -->
                <section id="inputArea" class="panel exp-input-area disabled">
                    <h2>Your message</h2>
                    <div class="form-group">
                        <label>Address to:</label>
                        <select id="targetSelect" class="wizard-select"></select>
                    </div>
                    <div class="form-group">
                        <label>Message:</label>
                        <textarea id="messageInput" class="wizard-input" rows="3" placeholder="Type your message..."></textarea>
                    </div>
                    <div class="form-group" style="display: flex; gap: 12px; align-items: center;">
                        <select id="toneSelect" class="wizard-select" style="width: auto; min-width: 120px;">
                            <option value="auto">Auto tone</option>
                            <option value="positive">Positive</option>
                            <option value="neutral" selected>Neutral</option>
                            <option value="negative">Negative</option>
                        </select>
                        <button id="sendBtn" class="btn btn-primary" disabled>Send</button>
                    </div>
                </section>

                <!-- Transcript -->
                <section class="panel transcript" style="min-height: 300px;">
                    <h2>Transcript</h2>
                    <div id="transcript" class="scroll"></div>
                </section>
            </div>

            <!-- Right column: graph -->
            <div>
                <section class="panel graph">
                    <h2>Interaction graph</h2>
                    <div class="img-wrap">
                        <div id="graphPlaceholder" class="graph-placeholder">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2">
                                <circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/>
                                <circle cx="12" cy="18" r="2"/><circle cx="6" cy="14" r="2"/>
                                <line x1="7.5" y1="7" x2="11" y2="16.5" opacity="0.5"/>
                                <line x1="16.5" y1="7" x2="13" y2="16.5" opacity="0.5"/>
                            </svg>
                            <span>Graph appears after 5 messages</span>
                        </div>
                        <img id="graphImg" src="" alt="Graph" style="display:none;" />
                    </div>
                </section>
            </div>
        </div>

        <footer class="footer">
            <span id="status">Ready</span>
        </footer>
    </div>

    <script src="/static/experiment.js"></script>
</body>
</html>
</file>

<file path="webapp/templates/index.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agent Dialogue — Web</title>
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================== SETUP WIZARD ==================== -->
    <div id="setupWizard" class="wizard-overlay">
        <div class="wizard-container">
            <!-- Step 1: Agent Count -->
            <div id="step1" class="wizard-step active">
                <div class="wizard-header">
                    <div class="wizard-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
                            <circle cx="20" cy="6" r="2" stroke-dasharray="2 2"/>
                            <circle cx="4" cy="6" r="2" stroke-dasharray="2 2"/>
                        </svg>
                    </div>
                    <h1>Agent Dialogue Simulator</h1>
                    <p class="wizard-subtitle">Configure your multi-agent conversation</p>
                </div>

                <div class="wizard-content">
                    <label class="wizard-label">Number of participants</label>
                    <div class="slider-container">
                        <input type="range" id="agentCountSlider" class="agent-slider" min="2" max="20" value="3">
                        <div class="slider-value"><span id="sliderValue">3</span> agents</div>
                    </div>

                    <label class="wizard-label" style="margin-top: 28px;">Environment context</label>
                    <select id="wizardEnvSelect" class="wizard-select">
                        {% for e in envs %}
                            <option value="{{ loop.index0 }}">{{ e }}</option>
                        {% endfor %}
                    </select>

                    <label class="wizard-label" style="margin-top: 28px; display: flex; align-items: center; gap: 12px; cursor: pointer;">
                        <input type="checkbox" id="joinAsParticipant" checked style="width: 18px; height: 18px; accent-color: var(--accent);">
                        Join as participant
                    </label>
                    <p class="wizard-hint" style="margin-top: 4px; font-size: 12px; color: var(--text-dim);">You will appear as "User" in the dialogue. Agents can address you.</p>
                </div>

                <div class="wizard-actions">
                    <button id="toStep2Btn" class="wizard-btn wizard-btn-primary">
                        Configure Agents
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
