<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agent Dialogue — Web</title>
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Persistent link to causal experiments -->
    <a href="/causal" style="position:fixed; top:14px; right:18px; z-index:9999; background:#4f46e5; color:#fff; padding:8px 14px; border-radius:6px; text-decoration:none; font-family:'Outfit',sans-serif; font-size:14px; font-weight:500; box-shadow:0 2px 8px rgba(0,0,0,0.3);">
        🔬 Каузальные эксперименты →
    </a>
    <!-- ==================== SETUP WIZARD ==================== -->
    <div id="setupWizard" class="wizard-overlay">
        <!-- Language toggle on the wizard (also visible before main app starts) -->
        <div id="langToggleWizard" class="lang-toggle" style="position:absolute; top:18px; right:18px; z-index:10;" title="Язык реплик агентов">
            <button type="button" data-lang="ru" class="lang-btn active">RU</button>
            <button type="button" data-lang="en" class="lang-btn">EN</button>
        </div>
        <div class="wizard-container">
            <!-- Step 0: Provider selection -->
            <div id="step0" class="wizard-step active">
                <div class="wizard-header">
                    <div class="wizard-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="3" y="4" width="18" height="14" rx="2"/>
                            <path d="M7 20h10M9 18v2M15 18v2"/>
                            <circle cx="8" cy="11" r="1.2" fill="currentColor"/>
                            <circle cx="16" cy="11" r="1.2" fill="currentColor"/>
                        </svg>
                    </div>
                    <h1>Подключение к модели</h1>
                    <p class="wizard-subtitle">Выберите провайдера и введите API-токен</p>
                </div>

                <div class="wizard-content">
                    <label class="wizard-label">Провайдер</label>
                    <div class="provider-grid">
                        <button type="button" class="provider-card" data-provider="chatgpt">
                            <div class="provider-card-title">ChatGPT</div>
                            <div class="provider-card-sub">OpenAI · gpt-4o-mini</div>
                            <div class="provider-card-hint">Токены: <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener">platform.openai.com</a></div>
                        </button>
                        <button type="button" class="provider-card" data-provider="deepseek">
                            <div class="provider-card-title">DeepSeek</div>
                            <div class="provider-card-sub">DeepSeek · deepseek-chat</div>
                            <div class="provider-card-hint">Токены: <a href="https://platform.deepseek.com/api_keys" target="_blank" rel="noopener">platform.deepseek.com</a></div>
                        </button>
                    </div>

                    <label class="wizard-label" style="margin-top:24px;">API-токен</label>
                    <input type="password" id="apiTokenInput" class="wizard-input" placeholder="sk-..." autocomplete="off" spellcheck="false">
                    <p class="wizard-hint" style="margin-top:6px;font-size:12px;color:var(--text-dim);">
                        Токен передаётся напрямую провайдеру и используется только в этой сессии — на сервере не сохраняется.
                    </p>

                    <div id="providerError" class="wizard-error" style="display:none;margin-top:10px;"></div>
                </div>

                <div class="wizard-actions">
                    <button id="toStep1Btn" class="wizard-btn wizard-btn-primary" disabled>
                        Продолжить
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Step 1: Agent Count -->
            <div id="step1" class="wizard-step">
                <div class="wizard-header">
                    <div class="wizard-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
                            <circle cx="20" cy="6" r="2" stroke-dasharray="2 2"/>
                            <circle cx="4" cy="6" r="2" stroke-dasharray="2 2"/>
                        </svg>
                    </div>
                    <h1>Agent Dialogue Simulator</h1>
                    <p class="wizard-subtitle">Настройте многоагентный диалог</p>
                </div>

                <div class="wizard-content">
                    <label class="wizard-label">Количество участников</label>
                    <div class="slider-container">
                        <input type="range" id="agentCountSlider" class="agent-slider" min="2" max="20" value="3">
                        <div class="slider-value"><span id="sliderValue">3</span> агентов</div>
                    </div>

                    <label class="wizard-label" style="margin-top: 28px;">Контекст окружения</label>
                    <select id="wizardEnvSelect" class="wizard-select">
                        {% for e in envs %}
                            <option value="{{ loop.index0 }}">{{ e }}</option>
                        {% endfor %}
                    </select>

                    <label class="wizard-label" style="margin-top: 28px; display: flex; align-items: center; gap: 12px; cursor: pointer;">
                        <input type="checkbox" id="joinAsParticipant" checked style="width: 18px; height: 18px; accent-color: var(--accent);">
                        Войти в диалог как участник
                    </label>
                    <p class="wizard-hint" style="margin-top: 4px; font-size: 12px; color: var(--text-dim);">Вы появитесь в диалоге как «User». Агенты смогут к вам обращаться.</p>
                </div>

                <div class="wizard-actions">
                    <button id="backToStep0Btn" class="wizard-btn wizard-btn-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        Сменить провайдера
                    </button>
                    <button id="toStep2Btn" class="wizard-btn wizard-btn-primary">
                        Настроить агентов
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Step 2: Agent Configuration -->
            <div id="step2" class="wizard-step">
                <div class="wizard-header compact">
                    <div class="step-indicator">
                        <span class="step-badge">Агент <span id="currentAgentNum">1</span> из <span id="totalAgentNum">3</span></span>
                    </div>
                    <h2 id="agentConfigTitle">Настройка агента</h2>
                </div>

                <div class="wizard-content-scroll">
                    <div class="wizard-content agent-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Имя</label>
                                <input type="text" id="agentName" class="wizard-input" placeholder="например: Алексей, Мария, Иван…">
                            </div>
                        <div class="form-group">
                            <label>Роль / Характер</label>
                            <input type="text" id="agentNature" class="wizard-input" placeholder="например: исследователь, критик, учёный, менеджер…">
                        </div>
                            <div class="form-group color-group">
                                <label>Цвет</label>
                                <input type="color" id="agentColor" class="wizard-color" value="#6d9df4">
                            </div>
                        </div>

                        <div class="questionnaire">
                            <h3 class="questionnaire-title">Анкета социального поведения</h3>
                            <p class="questionnaire-hint">Ответьте на вопросы, чтобы задать паттерны поведения агента. Оставьте пустым, чтобы использовать значения по умолчанию для выбранной роли.</p>

                            <div class="questionnaire-section">
                                <h4 class="section-title">Базовая информация</h4>
                                <div class="form-group">
                                    <label>Профессиональный или образовательный бэкграунд</label>
                                    <input type="text" id="q_background" class="wizard-input" placeholder="например: студент 3 курса, бывший дизайнер, исследователь с опытом в AI…">
                                </div>

                                <div class="form-group">
                                    <label>Что вас мотивирует в групповых обсуждениях?</label>
                                    <input type="text" id="q_motivation" class="wizard-input" placeholder="например: поиск новых идей, предотвращение ошибок, достижение согласия…">
                                </div>
                            </div>

                            <div class="questionnaire-section">
                                <h4 class="section-title">Паттерны социального поведения</h4>
                                <div class="form-group">
                                    <label>Как вы обычно ведёте себя в группе?</label>
                                    <input type="text" id="q_social_style" class="wizard-input" placeholder="например: говорю первым, предпочитаю слушать, ищу компромиссы, задаю много вопросов…">
                                </div>

                                <div class="form-group">
                                    <label>Как реагируете на разногласия в группе?</label>
                                    <input type="text" id="q_conflict_approach" class="wizard-input" placeholder="например: открыто спорю, ищу компромисс, меняю тему, анализирую причины…">
                                </div>

                                <div class="form-group">
                                    <label>Как принимаете решения в группе?</label>
                                    <input type="text" id="q_decision_style" class="wizard-input" placeholder="например: быстро предлагаю варианты, долго думаю, советуюсь, опираюсь на данные…">
                                </div>

                                <div class="form-group">
                                    <label>Насколько доверяете чужому мнению?</label>
                                    <input type="text" id="q_trust_level" class="wizard-input" placeholder="например: обычно доверяю, проверяю факты, скептичен, доверяю экспертам…">
                                </div>

                                <div class="form-group">
                                    <label>Как предпочитаете работать с другими?</label>
                                    <input type="text" id="q_cooperation_style" class="wizard-input" placeholder="например: активно сотрудничаю, работаю один, конкурирую идеями, поддерживаю других…">
                                </div>

                                <div class="form-group">
                                    <label>Насколько открыто выражаете эмоции в группе?</label>
                                    <input type="text" id="q_emotional_openness" class="wizard-input" placeholder="например: очень открыто, сдержанно, только позитив, аналитично без эмоций…">
                                </div>

                                <div class="form-group">
                                    <label>Как ведёте себя в роли лидера?</label>
                                    <input type="text" id="q_leadership_tendency" class="wizard-input" placeholder="например: беру инициативу, поддерживаю лидера, работаю в фоне, координирую процесс…">
                                </div>

                                <div class="form-group">
                                    <label>Как реагируете на критику ваших идей?</label>
                                    <input type="text" id="q_criticism_reaction" class="wizard-input" placeholder="например: защищаю, анализирую конструктивно, принимаю спокойно, ищу компромисс…">
                                </div>

                                <div class="form-group">
                                    <label>Что для вас важно в групповой динамике?</label>
                                    <input type="text" id="q_group_dynamics" class="wizard-input" placeholder="например: чтобы всех слышали, эффективность, структура, атмосфера…">
                                </div>
                            </div>

                            <div class="questionnaire-section">
                                <h4 class="section-title">Стиль речи</h4>
                                <div class="form-group">
                                    <label>Речевые привычки, особенности, мелкие ошибки?</label>
                                    <input type="text" id="q_speech_flaws" class="wizard-input" placeholder="например: говорю «типа», использую сленг, слова-паразиты, длинные паузы…">
                                </div>

                                <div class="form-group">
                                    <label>Любимые темы, которые часто поднимаете?</label>
                                    <input type="text" id="q_favorite_topics" class="wizard-input" placeholder="например: практические эксперименты, риски и проблемы, общие цели, данные и метрики…">
                                </div>

                                <div class="form-group">
                                    <label>Как реагируете, когда обсуждение застряло или напряжённое?</label>
                                    <input type="text" id="q_stress_reaction" class="wizard-input" placeholder="например: пошутить, взять паузу, указать на проблему, предложить структуру…">
                                </div>

                                <div class="form-group">
                                    <label>Фраза, которую часто используете?</label>
                                    <input type="text" id="q_signature_phrase" class="wizard-input" placeholder="например: «Давайте проверим», «А что если…», «Слушайте, нам нужно…»">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="wizard-actions">
                    <button id="backToStep1Btn" class="wizard-btn wizard-btn-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        Назад
                    </button>
                    <button id="prevAgentBtn" class="wizard-btn wizard-btn-secondary" style="display: none;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        Предыдущий
                    </button>
                    <button id="nextAgentBtn" class="wizard-btn wizard-btn-primary">
                        Следующий агент
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                    <button id="startDialogueBtn" class="wizard-btn wizard-btn-success" style="display: none;">
                        Начать диалог
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"/>
                        </svg>
                    </button>
                </div>

                <!-- Agent preview cards -->
                <div id="agentPreview" class="agent-preview">
                    <h4>Настроенные агенты</h4>
                    <div id="agentCards" class="agent-cards"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== MAIN DIALOGUE INTERFACE ==================== -->
    <div id="mainApp" class="container" data-env-count="{{ envs|length }}" style="display: none;">
        <header class="header">
            <div>
                <h1>Многоагентный диалог</h1>
                <p class="subtitle">Графы, гипотезы и метрики обновляются каждые 5 ходов</p>
            </div>
            <div class="controls">
                <div id="langToggle" class="lang-toggle" title="Язык реплик агентов">
                    <button type="button" data-lang="ru" class="lang-btn active">RU</button>
                    <button type="button" data-lang="en" class="lang-btn">EN</button>
                </div>
                <button id="newSessionBtn" class="btn">Новая сессия</button>
                <button id="participateBtn" class="btn btn-participate" style="display: none;">Войти в диалог</button>
                <button id="stepBtn" class="btn btn-primary" disabled>Следующий ход</button>
                <a class="btn btn-download" id="downloadLog" href="/download/log">Скачать JSONL</a>
                <a class="btn" id="downloadLogMd" href="/download/log_md">Скачать MD</a>
            </div>
        </header>

        <!-- Agent badges -->
        <div id="agentBadges" class="agent-badges"></div>

        <!-- Tab navigation for analysis views -->
        <div class="tab-nav">
            <button class="tab-btn active" data-tab="dialogue">💬 Диалог</button>
            <button class="tab-btn" data-tab="scientific">🔬 Научный анализ</button>
            <!-- Advanced Analytics и Observer Agent скрыты (нестабильно работают) -->
            <button class="tab-btn" data-tab="advanced" style="display:none;">📈 Продвинутая аналитика</button>
            <button class="tab-btn" data-tab="observer" style="display:none;">🔭 Агент-наблюдатель</button>
        </div>

        <!-- DIALOGUE TAB -->
        <main id="dialogueTab" class="grid tab-content active">
            <section class="panel transcript">
                <h2>Диалог</h2>
                <div id="typing" class="typing" style="display:none;">
                    <span>Агент печатает</span>
                    <span class="dots"><i>.</i><i>.</i><i>.</i></span>
                </div>
                <div id="transcript" class="scroll"></div>
            </section>

            <section class="panel graph">
                <h2>Граф взаимодействий</h2>
                <div class="img-wrap">
                    <div id="graphPlaceholder" class="graph-placeholder">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2">
                            <circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/>
                            <circle cx="12" cy="18" r="2"/><circle cx="6" cy="14" r="2"/>
                            <line x1="7.5" y1="7" x2="11" y2="16.5" opacity="0.5"/>
                            <line x1="16.5" y1="7" x2="13" y2="16.5" opacity="0.5"/>
                            <line x1="6" y1="8" x2="6" y2="12" opacity="0.5"/>
                            <line x1="8" y1="6" x2="16" y2="6" opacity="0.3"/>
                        </svg>
                        <span>Граф появится после 5 ходов</span>
                    </div>
                    <img id="graphImg" src="" alt="Граф взаимодействий" style="display:none;" />
                </div>
            </section>

            <section class="panel verdicts" id="verdictsPanel">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;">
                    <h2 style="margin:0;">Научный отчёт по гипотезам и теориям <span id="verdictsTurn" style="font-weight:normal;font-size:13px;color:var(--text-secondary,#9ca3af);"></span></h2>
                    <a id="downloadScientificReport" class="btn btn-download" href="/download/scientific_report" style="display:none;" title="Скачать markdown-отчёт со всеми verdict'ами для научного руководителя">📥 Скачать отчёт</a>
                </div>
                <div id="verdictsGrid" class="verdict-grid">
                    <div class="metrics-empty">Анализ теорий появится после 5 ходов диалога</div>
                </div>
            </section>

            <section class="panel insights">
                <h2>Эвристические гипотезы</h2>
                <ul id="hyps" class="list"></ul>
            </section>

            <section class="panel metrics">
                <h2>Метрики <span id="metricsTurn" style="font-weight:normal;font-size:13px;color:var(--text-secondary,#9ca3af);"></span></h2>
                <div id="metricsCards" class="metrics-cards-grid"></div>
                <div id="metricsAgents" style="margin-top:16px;"></div>
            </section>
        </main>

        <!-- SCIENTIFIC ANALYSIS TAB -->
        <main id="scientificTab" class="scientific-grid tab-content">
            <section class="panel scientific-report">
                <h2>🔬 Scientific Analysis Report</h2>
                <div class="scientific-info">
                    <p>This analysis is based on modern scientific frameworks (2010-2025):</p>
                    <ul>
                        <li><strong>Multidimensional Networks in Teams</strong> — Contractor et al. (2012)</li>
                        <li><strong>Network Dynamics & Team Performance</strong> — Reagans et al. (2016); Leenders et al. (2016)</li>
                        <li><strong>Dialogue Act Taxonomy</strong> — ISO 24617-2, Bunt et al. (2020)</li>
                        <li><strong>Computational Dialogue Analysis</strong> — Jurafsky & Martin (2024)</li>
                        <li><strong>Language Style Matching & LIWC</strong> — Tausczik & Pennebaker (2010); Gonzales et al. (2010)</li>
                        <li><strong>High-Dimensional Emotion Model</strong> — Cowen & Keltner (2017); Demszky et al. (2020)</li>
                        <li><strong>Team Temporal Dynamics</strong> — Shuffler et al. (2018); Mathieu et al. (2017)</li>
                        <li><strong>Affect in Text & Sentiment</strong> — Mohammad et al. (2018)</li>
                    </ul>
                </div>
                <div id="scientificReport" class="scroll scientific-content"></div>
            </section>

            <section class="panel scientific-hypotheses">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h2 style="margin: 0;">📚 Scientific Hypotheses</h2>
                    <a class="btn btn-download" id="downloadValidation" href="/download/validation" style="display: none;" title="Скачать отчёт о проверке гипотез с доказательствами">📥 Download Validation Report</a>
                </div>
                <div id="scientificHypotheses" class="scroll"></div>
            </section>
        </main>

        <!-- ADVANCED ANALYTICS TAB -->
        <main id="advancedTab" class="scientific-grid tab-content">
            <section class="panel scientific-report">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
                    <h2 style="margin:0;">📈 Advanced Analytics</h2>
                    <button id="loadAdvancedBtn" class="btn btn-primary">Load Analysis</button>
                </div>
                <div class="scientific-info">
                    <p>Emotional Contagion, Language Style Matching, and Discourse Coherence analysis.</p>
                    <ul>
                        <li><strong>Emotional Contagion</strong> — Barsade (2002); Hatfield et al. (1994)</li>
                        <li><strong>Language Style Matching</strong> — Gonzales et al. (2010); Tausczik & Pennebaker (2010)</li>
                        <li><strong>Discourse Coherence</strong> — Graesser et al. (2014); McNamara et al. (2014)</li>
                    </ul>
                </div>
                <div id="advancedReport" class="scroll scientific-content">
                    <p style="color:var(--text-secondary);padding:2rem;text-align:center;">
                        Click "Load Analysis" after at least 3 dialogue turns.
                    </p>
                </div>
            </section>

            <section class="panel scientific-hypotheses">
                <h2>📊 Key Metrics</h2>
                <div id="advancedMetrics">
                    <p style="color:var(--text-secondary);padding:2rem;text-align:center;">
                        No data yet.
                    </p>
                </div>
            </section>
        </main>

        <!-- OBSERVER AGENT TAB -->
        <main id="observerTab" class="scientific-grid tab-content">
            <section class="panel scientific-report">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h2 style="margin: 0;">🔭 Observer Agent — Methodological Triangulation</h2>
                    <button id="runObserverBtn" class="btn btn-primary">Run Observer Analysis</button>
                </div>
                <div class="scientific-info">
                    <p>Non-participating LLM observer that independently analyzes dialogue and compares
                    its qualitative findings with algorithmic metrics (Denzin, 2012).</p>
                </div>
                <div id="observerReport" class="scroll scientific-content">
                    <p style="color: var(--text-secondary); padding: 2rem; text-align: center;">
                        Click "Run Observer Analysis" after at least 3 dialogue turns to generate a triangulation report.
                    </p>
                </div>
            </section>

            <section class="panel scientific-hypotheses">
                <h2>📚 Hypothesis Registry</h2>
                <div id="observerHypothesisChecks" class="scroll" style="max-height: 420px; margin-bottom: 1rem;">
                    <p style="color: var(--text-secondary); padding: 2rem; text-align: center;">
                        The theory-backed hypothesis list will appear here when the dialogue starts.
                    </p>
                </div>
                <h2 style="margin-top: 0;">📈 Triangulation Summary</h2>
                <div id="triangulationSummary" class="scroll">
                    <p style="color: var(--text-secondary); padding: 2rem; text-align: center;">
                        No observations yet. Run the observer to see convergence/divergence analysis.
                    </p>
                </div>
            </section>
        </main>

        <footer class="footer">
            <span id="status">Готово</span>
        </footer>
    </div>

    <!-- User participation modal -->
    <div id="userInputModal" class="modal-overlay" style="display: none;">
        <div class="modal-card">
            <h3>Ваш ход</h3>
            <div class="form-group">
                <label>Обратиться к:</label>
                <select id="userTargetSelect" class="wizard-select"></select>
            </div>
            <div class="form-group">
                <label>Ваше сообщение:</label>
                <textarea id="userReplyInput" class="wizard-input" rows="3" placeholder="Напишите сообщение…"></textarea>
            </div>
