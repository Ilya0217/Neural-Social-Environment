# Скопируйте в .env и заполните реальными значениями.
# .env лежит рядом с docker-compose.yml на сервере и НЕ коммитится.

# --- LLM-провайдер (обязательно один) -------------------------------------
# OpenAI:
OPENAI_API_KEY=sk-...
# OpenAI-совместимый прокси (например, OpenRouter / DeepSeek) — опционально:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# --- Поведение симулятора --------------------------------------------------
ENV_CONTEXT_INDEX=0

# --- Образ для docker compose (на сервере подставляется деплой-скриптом) ---
# В CI выставляется на ghcr.io/ilya0217/agent-dialogue-sim:<sha>.
# Локально оставьте пустым, чтобы docker compose build собрал из исходников.
APP_IMAGE=ghcr.io/ilya0217/agent-dialogue-sim:latest

# --- Параметры выпуска Let's Encrypt (используются deploy/init-letsencrypt.sh)
LETSENCRYPT_EMAIL=admin@agent-dialogue.ru
LETSENCRYPT_DOMAINS=agent-dialogue.ru www.agent-dialogue.ru
# На время отладки certbot можно включить staging (избежать rate-limit):
# LETSENCRYPT_STAGING=1
