        md.append("|---|---:|---:|---:|")
        for a in sorted(scientific.centrality.keys()):
            c = scientific.centrality[a]
            b = scientific.betweenness.get(a, 0)
            md.append(f"| {a} | {pct(c.get('in_centrality', 0))} | {pct(c.get('out_centrality', 0))} | {pct(b)} |")
        md.append("")
    
    # speaking shares (as table)
