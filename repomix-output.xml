        .exp-list { display:flex; flex-direction:column; gap:8px; }
        .exp-item { background:#22262f; padding:12px 16px; border-radius:8px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; border:1px solid transparent; }
        .exp-item:hover { border-color:#4f46e5; }
        .exp-item.selected { border-color:#4f46e5; background:#1e1b4b; }
        .exp-meta { color:#9ca3af; font-size:12px; }
        .pair-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(80px,1fr)); gap:8px; }
        .pair-btn { background:#22262f; padding:10px; border-radius:6px; cursor:pointer; text-align:center; font-family:'JetBrains Mono',monospace; }
        .pair-btn:hover { background:#374151; }
