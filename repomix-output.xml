    <title>Каузальные интервенции — Agent Dialogue Sim</title>
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', system-ui, sans-serif; background:#0f1115; color:#e5e7eb; margin:0; padding:0; }
        .nav { background:#1a1d24; padding:12px 24px; display:flex; gap:16px; align-items:center; border-bottom:1px solid #2a2f3a; }
        .nav a { color:#9ca3af; text-decoration:none; padding:6px 12px; border-radius:6px; }
