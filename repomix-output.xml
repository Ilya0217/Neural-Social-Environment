    agent_overrides:
      big_five:
        openness: 0.5
        conscientiousness: 0.5
        extraversion: 0.2
        agreeableness: 0.5
        neuroticism: 0.5

  - name: mid
    n_dialogues: 160
    seed_offset: 200
    agent_overrides:
      big_five:
        openness: 0.5
        conscientiousness: 0.5
        extraversion: 0.5
        agreeableness: 0.5
        neuroticism: 0.5

  - name: high
