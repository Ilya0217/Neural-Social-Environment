                f"— {_interpret_effect(a.get('cohens_d_z'))} эффект."
            )
        md.append("")

    # ----- 6. Per-pair raw ITE -----
    md.append("## 6. Per-pair Individual Treatment Effects (контролируемая прозрачность)")
    md.append("")
    md.append(
