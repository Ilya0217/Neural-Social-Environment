    md.append("| Agent | Share |")
    md.append("|---|---:|")
    for a, v in sorted(tt.items(), key=lambda kv: kv[1], reverse=True):
        md.append(f"| {a} | {pct(v)} |")
    md.append("")
    return "\n".join(md)

