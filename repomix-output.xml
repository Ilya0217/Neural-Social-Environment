        +export_to_excel(history, metrics, filename) : Path
        +export_to_json(history, metrics, filename) : Path
        +export_research_report(history, metrics, filename) : Path
        +export_all_formats(history, metrics, base_name) : Dict
    }
    
    class IOLogger {
