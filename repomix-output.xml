class TestParseResponse(unittest.TestCase):
    def test_valid_json(self):
        content = (
            '{"openness": 5, "conscientiousness": 4, "extraversion": 7, '
            '"agreeableness": 6, "neuroticism": 2, "reasoning": "very chatty"}'
        )
        rating = _parse_judge_response(content)
