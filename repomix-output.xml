        +serve_outputs(filename) : Response
        +download_log() : Response
    }
}

package "Configuration" {
    
    class Config {
        <<configuration>>
        +str MODEL
        +float TEMPERATURE
        +int MAX_TOKENS
        +List[Dict] DEFAULT_AGENTS
        +List[Dict] DIALOGUE_PHASES
        +float MOOD_DECAY
        +Dict MOOD_DELTA
        +List[Tuple] MOOD_GUIDANCE
    }
}

